+/// Decode with caller-chosen pixel limits, without changing the existing poster defaults.
+///
+/// `max_axis` bounds BOTH dimensions. `max_rgba_bytes` strictly bounds both the
+/// decoder's output-image buffer and the RGBA8 result, checked from header metadata
+/// BEFORE pixel decode or conversion. The caller separately bounds encoded bytes.
+///
+/// Codec bookkeeping gets `image::Limits::max_alloc = max(max_rgba_bytes, 64 KiB)`,
+/// installed before decoder construction and reduced by the output-buffer reservation
+/// before pixel decode. That codec limit is best-effort: `image` documents max_alloc
+/// as non-strict, and some codec allocations do not honour it. The two image buffers,
+/// encoded bytes and bookkeeping can coexist; this is NOT a total-heap bound or an
+/// OOM guarantee. As in the default path, decoder panics become `None`; allocation
+/// aborts cannot be caught. No GL operation is performed here.
+pub fn img_decode_owned_bounded(
+    data: &[u8],
+    max_axis: u32,
+    max_rgba_bytes: u64,
+) -> Option<(u32, u32, Vec<u8>)> {
+    if data.is_empty() {
+        return None;
+    }
+    let limits = owned_decode_limits(max_axis, max_rgba_bytes)?;
+    catch_unwind(AssertUnwindSafe(|| {
+        let mut reader = image::ImageReader::new(std::io::Cursor::new(data))
+            .with_guessed_format()
+            .ok()?;
+        // PNG consumes these limits while constructing its header decoder. Other
+        // enabled codecs receive them through ImageReader::into_decoder.
+        reader.limits(limits.clone());
+        let decoder = reader.into_decoder().ok()?;
+        decode_owned_bounded_decoder(decoder, max_axis, max_rgba_bytes, limits)
+    }))
+    .ok()
+    .flatten()
+}
+
+fn owned_decode_limits(max_axis: u32, max_rgba_bytes: u64) -> Option<image::Limits> {
+    // At least one RGBA8 pixel must fit, and Vec buffers cannot exceed isize::MAX.
+    if max_axis == 0 || max_rgba_bytes < 4 || max_rgba_bytes > isize::MAX as u64 {
+        return None;
+    }
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(max_axis);
+    limits.max_image_height = Some(max_axis);
+    limits.max_alloc = Some(max_rgba_bytes.max(64 * 1024));
+    Some(limits)
+}
+
+fn bounded_rgba_len(width: u32, height: u32, max_axis: u32, max_bytes: u64) -> Option<usize> {
+    if width == 0 || height == 0 || width > max_axis || height > max_axis {
+        return None;
+    }
+    let bytes = u64::from(width).checked_mul(u64::from(height))?.checked_mul(4)?;
+    if bytes > max_bytes || bytes > isize::MAX as u64 {
+        return None;
+    }
+    usize::try_from(bytes).ok()
+}
+
+fn decode_owned_bounded_decoder(
+    mut decoder: impl image::ImageDecoder,
+    max_axis: u32,
+    max_rgba_bytes: u64,
+    mut limits: image::Limits,
+) -> Option<(u32, u32, Vec<u8>)> {
+    let (width, height) = decoder.dimensions();
+    let rgba_len = bounded_rgba_len(width, height, max_axis, max_rgba_bytes)?;
+    let decoded_bytes = decoder.total_bytes();
+    // A high-bit-depth source may need MORE memory than its eventual RGBA8 output.
+    // Reject that image before DynamicImage allocates its native pixel buffer.
+    if decoded_bytes == 0 || decoded_bytes > max_rgba_bytes || decoded_bytes > isize::MAX as u64 {
+        return None;
+    }
+    limits.reserve(decoded_bytes).ok()?;
+    decoder.set_limits(limits).ok()?;
+    let decoded = image::DynamicImage::from_decoder(decoder).ok()?;
+    if decoded.width() != width || decoded.height() != height {
+        return None;
+    }
+    // Consuming avoids copying an already-RGBA8 image. For other pixel types the
+    // conversion allocation is independently bounded by the checked header size.
+    let rgba = decoded.into_rgba8();
+    let raw = rgba.into_raw();
+    (raw.len() == rgba_len).then_some((width, height, raw))
+}
