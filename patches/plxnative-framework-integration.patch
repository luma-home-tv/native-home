+    fn signed_steps_and_cancel_never_change_saved_or_emit_an_unchanged_proposal() {
+        let scale = RangeScale::new(-15, 15, 1).unwrap();
+        let mut state = StagedRange::new(scale, -15).unwrap();
+        assert!(!state.nudge(RangeStep::Decrease));
+        assert_eq!(state.proposal(), None);
+        for expected in -14..=15 {
+            assert!(state.nudge(RangeStep::Increase));
+            assert_eq!(state.staged(), expected);
+            assert_eq!(state.saved(), -15);
+        }
+        assert!(!state.nudge(RangeStep::Increase));
+        assert_eq!(state.proposal(), Some((-15, 15)));
+        assert!(!state.confirm(-14, 15));
+        state.cancel();
+        assert_eq!(state.staged(), -15);
+        assert!(!state.dirty());
