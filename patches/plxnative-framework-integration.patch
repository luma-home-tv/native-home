+#[derive(Clone, Copy)]
+pub struct TextEntryLayout {
+    pub clip: Rect,
+    pub before_x: f32,
+    pub preedit_x: f32,
+    pub after_x: f32,
+    pub caret: Rect,
+    pub preedit_underline: Rect,
+}
+impl TextEntryLayout {
+    pub fn new(frame: Rect, before: f32, preedit: f32, after: f32) -> Option<Self> {
+        if ![frame.x, frame.y, frame.w, frame.h, before, preedit, after]
+            .iter()
+            .all(|v| v.is_finite())
+            || frame.w < 120.0
+            || frame.h < 48.0
+            || before < 0.0
+            || preedit < 0.0
+            || after < 0.0
+        {
+            return None;
+        }
+        let clip = Rect::new(
+            frame.x + 24.0,
+            frame.y + 8.0,
+            frame.w - 48.0,
+            frame.h - 16.0,
+        );
+        let offset = (before + preedit - (clip.w - 10.0)).max(0.0);
+        let before_x = clip.x - offset;
+        let preedit_x = before_x + before;
+        let after_x = preedit_x + preedit;
+        let caret = Rect::new(after_x, frame.cy() - 16.0, 2.0, 32.0);
+        Some(Self {
+            clip,
+            before_x,
+            preedit_x,
+            after_x,
+            caret,
+            preedit_underline: Rect::new(preedit_x, frame.cy() + 17.0, preedit, 1.0),
+        })
+    }
+}
+/// Native, horizontally clipped text entry with a static caret and separate IME preedit.
+/// The caller owns editing and focus; this leaf has no keyboard, timer or service access.
+pub struct TextEntry<'a> {
+    pub frame: Rect,
+    pub before: &'a str,
+    pub preedit: &'a str,
+    pub after: &'a str,
+    pub placeholder: &'a str,
+    pub focused: bool,
+}
+/// Keep GPU text uploads near the viewport without changing the draft. Measurements
+/// are CPU-only. Two context graphemes at each edge keep the cut outside visible ink;
+/// right anchoring also preserves pair kerning at the removed prefix boundary.
+///
+/// A grapheme is not a texture-size bound (an extended cluster may contain thousands
+/// of advancing fallback glyphs). If one cluster alone exceeds the upload budget,
+/// leave that cluster unpainted rather than splitting it or uploading an unsafe run.
+fn text_entry_visible_span(
+    text: &str,
+    x: f32,
+    clip: Rect,
+    mut measure: impl FnMut(&str) -> f32,
+) -> Option<(std::ops::Range<usize>, f32)> {
+    use unicode_segmentation::UnicodeSegmentation;
+    if text.is_empty()
+        || ![x, clip.x, clip.w, clip.x + clip.w]
+            .iter()
+            .all(|v| v.is_finite())
+        || clip.w <= 0.0
+    {
+        return None;
+    }
+    let full = measure(text);
+    if !full.is_finite() || full < 0.0 || x >= clip.x + clip.w || x + full <= clip.x {
+        return None;
+    }
+    let edges = text
+        .grapheme_indices(true)
+        .map(|(i, _)| i)
+        .chain(std::iter::once(text.len()))
+        .collect::<Vec<_>>();
+    let mut valid = true;
+    let mut edge_x = |i: usize| {
+        let width = if i == 0 {
+            0.0
+        } else if i == text.len() {
+            full
+        } else {
+            measure(&text[..i])
+        };
+        valid &= width.is_finite() && width >= 0.0;
+        x + width
+    };
+    let mut first = edges
+        .partition_point(|i| edge_x(*i) < clip.x)
+        .saturating_sub(2);
+    let mut last =
+        (edges.partition_point(|i| edge_x(*i) < clip.x + clip.w) + 1).min(edges.len() - 1);
+    if !valid {
+        return None;
+    }
+    let budget = clip.w + 4.0 * theme::size::LABEL as f32;
+    while first < last {
+        let from = edges[first];
+        let to = edges[last];
+        let width = measure(&text[from..to]);
+        let right = if to == text.len() {
+            full
+        } else {
+            measure(&text[..to])
+        };
+        if ![width, right].iter().all(|v| v.is_finite() && *v >= 0.0) {
+            return None;
+        }
+        let draw_x = x + right - width;
+        if width <= budget {
+            return (draw_x < clip.x + clip.w && draw_x + width > clip.x)
+                .then_some((from..to, draw_x));
+        }
+        // Prefer removing context outside the viewport. At worst this reaches one
+        // oversized cluster, which is rejected without a GPU allocation.
+        let left_excess = (clip.x - draw_x).max(0.0);
+        let right_excess = (draw_x + width - clip.x - clip.w).max(0.0);
+        if left_excess >= right_excess {
+            first += 1;
+        } else {
+            last -= 1;
+        }
+    }
+    None
+}
+impl View for TextEntry<'_> {
+    fn draw(&self, _e: &Env, p: Painter) {
+        let strings = [self.before, self.preedit, self.after, self.placeholder]
+            .map(|s| CString::new(s.replace('\0', "")).unwrap());
+        let widths = [0, 1, 2].map(|i| {
+            LegacyMeasure
+                .bounds(&strings[i], theme::size::LABEL, false)
+                .0
+        });
+        let Some(l) = TextEntryLayout::new(self.frame, widths[0], widths[1], widths[2]) else {
+            return;
+        };
+        p.rrect(self.frame, 18.0, 18.0, theme::CONTROL_IDLE_FILL);
+        if self.focused {
+            p.rring(self.frame, 18.0, 2.0, theme::TEXT_PRIMARY);
+        }
+        let _clip = crate::screen::ClipScope::open_in(p, l.clip);
+        let measure = |text: &str| {
+            let text = CString::new(text).unwrap();
+            LegacyMeasure.bounds(&text, theme::size::LABEL, false).0
+        };
+        let draw = |text: &CStr, x: f32, color| {
+            let text = text.to_str().unwrap();
+            if let Some((span, x)) = text_entry_visible_span(text, x, l.clip, measure) {
+                let visible = CString::new(&text[span]).unwrap();
+                let width = LegacyMeasure.bounds(&visible, theme::size::LABEL, false).0;
+                Label::new(visible.as_ptr(), theme::size::LABEL, color)
+                    .draw(p, Rect::new(x, l.clip.y, width, l.clip.h));
+            }
+        };
+        if self.before.is_empty() && self.preedit.is_empty() && self.after.is_empty() {
+            draw(&strings[3], l.clip.x, theme::TEXT_SECONDARY);
+        } else {
+            for (i, x) in [(0, l.before_x), (1, l.preedit_x), (2, l.after_x)] {
+                draw(
+                    &strings[i],
+                    x,
+                    if i == 1 {
+                        theme::TEXT_SECONDARY
+                    } else {
+                        theme::TEXT_PRIMARY
+                    },
+                );
+            }
+        }
+        if self.focused {
+            p.rrect(l.caret, 0.0, 0.0, theme::TEXT_PRIMARY);
+        }
+        if widths[1] > 0.0 {
+            p.rrect(l.preedit_underline, 0.0, 0.0, theme::TEXT_SECONDARY);
+        }
+    }
+}
+#[cfg(test)]
+mod text_entry_tests {
+    use super::*;
+    #[test]
+    fn cropped_text_keeps_its_original_right_anchor_under_kerning() {
+        let text = "AV".repeat(100);
+        let measure = |s: &str| {
+            s.len() as f32 * 20.0
+                - s.as_bytes().windows(2).filter(|p| *p == b"AV").count() as f32 * 5.0
+        };
+        let clip = Rect::new(100.0, 0.0, 200.0, 40.0);
+        for x in [-200.0, -215.0, -230.0] {
+            let (span, draw_x) = text_entry_visible_span(&text, x, clip, measure).unwrap();
+            assert_eq!(
+                draw_x + measure(&text[span.clone()]),
+                x + measure(&text[..span.end])
+            );
+        }
+    }
+    #[test]
+    fn oversized_grapheme_and_invalid_metrics_never_reach_the_text_upload() {
+        let clip = Rect::new(100.0, 0.0, 200.0, 40.0);
+        // Prepend scalars form one extended grapheme with the final base. A font's
+        // fallback may give every one nonzero advance: grapheme count is no width bound.
+        let text = format!("{}W", "\u{600}".repeat(1000));
+        let measure = |s: &str| s.chars().count() as f32 * 26.0;
+        assert!(text_entry_visible_span(&text, -500.0, clip, measure).is_none());
+        for width in [f32::NAN, f32::INFINITY, -1.0] {
+            assert!(text_entry_visible_span("text", 100.0, clip, |_| width).is_none());
+        }
+    }
+    #[test]
+    fn visible_upload_is_bounded_and_keeps_graphemes_and_the_caret_end() {
+        use unicode_segmentation::UnicodeSegmentation;
+        let text = "e\u{301}👨‍👩‍👧‍👦W".repeat(256);
+        let measure = |s: &str| s.graphemes(true).count() as f32 * 24.0;
+        let clip = Rect::new(100.0, 0.0, 650.0, 40.0);
+        for x in [100.0, -8000.0, clip.x + clip.w - measure(&text) - 10.0] {
+            let (span, draw_x) = text_entry_visible_span(&text, x, clip, measure).unwrap();
+            let visible = &text[span.clone()];
+            assert!(measure(visible) <= clip.w + 4.0 * 24.0);
+            assert!(text.grapheme_indices(true).any(|(i, _)| i == span.start));
+            assert!(
+                span.end == text.len() || text.grapheme_indices(true).any(|(i, _)| i == span.end)
+            );
+            assert!(draw_x < clip.x + clip.w);
+            assert!(draw_x + measure(visible) >= clip.x);
+        }
+        let (span, _) = text_entry_visible_span(
+            &text,
+            clip.x + clip.w - measure(&text) - 10.0,
+            clip,
+            measure,
+        )
+        .unwrap();
+        assert_eq!(span.end, text.len());
+        assert!(text_entry_visible_span("outside", 1000.0, clip, measure).is_none());
+    }
+    #[test]
+    fn caret_start_middle_end_and_long_preedit_keep_the_adjacent_visible_runs() {
+        use unicode_segmentation::UnicodeSegmentation;
+        let text = "Ae\u{301}界👩🏽‍💻W".repeat(40);
+        let edges = text
+            .grapheme_indices(true)
+            .map(|(i, _)| i)
+            .chain(std::iter::once(text.len()));
+        let measure = |s: &str| s.graphemes(true).count() as f32 * 24.0;
+        for caret in edges {
+            for preedit in ["", "e\u{301}", &"界".repeat(100)] {
+                let before = &text[..caret];
+                let after = &text[caret..];
+                let l = TextEntryLayout::new(
+                    Rect::new(898.0, 248.0, 886.0, 58.0),
+                    measure(before),
+                    measure(preedit),
+                    measure(after),
+                )
+                .unwrap();
+                assert!(l.caret.x >= l.clip.x && l.caret.x + l.caret.w <= l.clip.x + l.clip.w);
+                let adjacent = if preedit.is_empty() { before } else { preedit };
+                let adjacent_x = if preedit.is_empty() {
+                    l.before_x
+                } else {
+                    l.preedit_x
+                };
+                if !adjacent.is_empty() {
+                    let (span, x) =
+                        text_entry_visible_span(adjacent, adjacent_x, l.clip, measure).unwrap();
+                    assert_eq!(
+                        span.end,
+                        adjacent.len(),
+                        "the insertion point's preceding grapheme stays present"
+                    );
+                    assert_eq!(x + measure(&adjacent[span]), l.caret.x);
+                }
+                if !after.is_empty() {
+                    let (span, x) =
+                        text_entry_visible_span(after, l.after_x, l.clip, measure).unwrap();
+                    assert_eq!(span.start, 0, "do not crop away the next editable grapheme");
+                    assert_eq!(x, l.caret.x);
+                }
+            }
+        }
+    }
+    #[test]
+    fn ordinary_crop_uses_logarithmic_metric_queries_without_rasterizing_prefixes() {
+        use std::cell::Cell;
+        let text = "W".repeat(16_384);
+        let calls = Cell::new(0);
+        let measure = |s: &str| {
+            calls.set(calls.get() + 1);
+            s.len() as f32 * 24.0
+        };
+        let clip = Rect::new(100.0, 0.0, 650.0, 40.0);
+        let (span, _) = text_entry_visible_span(&text, -100_000.0, clip, measure).unwrap();
+        assert!(span.len() <= 32);
+        assert!(
+            calls.get() < 40,
+            "do not measure every prefix or churn the bounded metric cache: {}",
+            calls.get()
+        );
+    }
+    #[test]
+    fn caret_stays_inside_the_clip_for_long_prefixes_and_preedit_without_tail_ellipses() {
+        for (before, preedit, after) in [
+            (0.0, 0.0, 0.0),
+            (100.0, 30.0, 0.0),
+            (4000.0, 0.0, 800.0),
+            (3500.0, 300.0, 500.0),
+            (0.0, 0.0, 4000.0),
+        ] {
+            let l =
+                TextEntryLayout::new(Rect::new(898.0, 248.0, 886.0, 58.0), before, preedit, after)
+                    .unwrap();
+            assert!(l.caret.x >= l.clip.x && l.caret.x + l.caret.w <= l.clip.x + l.clip.w);
+            assert_eq!(l.after_x, l.preedit_x + preedit);
+            assert_eq!(l.preedit_x, l.before_x + before);
+        }
+        assert!(TextEntryLayout::new(Rect::new(0.0, 0.0, 40.0, 58.0), 0.0, 0.0, 0.0).is_none());
+        assert!(
+            TextEntryLayout::new(Rect::new(0.0, 0.0, 886.0, 58.0), f32::NAN, 0.0, 0.0).is_none()
+        );
+    }
+}
