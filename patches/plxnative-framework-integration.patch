+/// Opt-in bounded thumbnail for worker-side consumers. Existing decode APIs and
+/// their poster defaults stay unchanged. Output never upscales; aspect ratio is
+/// retained within integer-pixel rounding. No GL, path, file or service access.
+///
+/// BOTH source native pixels and source RGBA8 are bounded before full pixel
+/// decode/conversion through the existing bounded decoder. A separate smaller
+/// output bound applies before allocation. Codec/header bookkeeping and allocator
+/// failure retain the limitations documented on img_decode_owned_bounded: these
+/// limits are NOT a total-heap, OOM, codec-time or shutdown guarantee.
+///
+/// Resampling allocates only the bounded output, without a full-size float or
+/// premultiplied intermediate. Each disjoint integer source box contributes
+/// alpha-weighted RGB and mean alpha; transparent texels cannot colour an opaque
+/// neighbour. This is an integer box approximation, not linear-light filtering
+/// or exact fractional-area/GPU emulation. No EXIF orientation transform is added.
+pub fn img_decode_owned_thumbnail_bounded(
+    data: &[u8],
+    max_input_axis: u32,
+    max_input_rgba_bytes: u64,
+    max_output_axis: u32,
+    max_output_rgba_bytes: u64,
+) -> Option<(u32, u32, Vec<u8>)> {
+    if data.is_empty() {
+        return None;
+    }
+    let limits = owned_decode_limits(max_input_axis, max_input_rgba_bytes)?;
+    owned_decode_limits(max_output_axis, max_output_rgba_bytes)?;
+    catch_unwind(AssertUnwindSafe(|| {
+        let mut reader = image::ImageReader::new(std::io::Cursor::new(data))
+            .with_guessed_format()
+            .ok()?;
+        reader.limits(limits.clone());
+        let decoder = reader.into_decoder().ok()?;
+        decode_thumbnail_bounded_decoder(
+            decoder, max_input_axis, max_input_rgba_bytes,
+            max_output_axis, max_output_rgba_bytes, limits,
+        )
+    }))
+    .ok()
+    .flatten()
+}
+
+fn thumbnail_dimensions(
+    width: u32, height: u32, max_axis: u32, max_rgba_bytes: u64,
+) -> Option<(u32, u32, usize)> {
+    if width == 0 || height == 0 || max_axis == 0 {
+        return None;
+    }
+    let longest = width.max(height);
+    let (out_width, out_height) = if longest <= max_axis {
+        (width, height)
+    } else {
+        let scaled = |side: u32| -> Option<u32> {
+            u32::try_from((u64::from(side).checked_mul(u64::from(max_axis))?
+                / u64::from(longest)).max(1)).ok()
+        };
+        (scaled(width)?, scaled(height)?)
+    };
+    let bytes = bounded_rgba_len(out_width, out_height, max_axis, max_rgba_bytes)?;
+    Some((out_width, out_height, bytes))
+}
+
+fn decode_thumbnail_bounded_decoder(
+    decoder: impl image::ImageDecoder,
+    max_input_axis: u32,
+    max_input_rgba_bytes: u64,
+    max_output_axis: u32,
+    max_output_rgba_bytes: u64,
+    limits: image::Limits,
+) -> Option<(u32, u32, Vec<u8>)> {
+    let (width, height) = decoder.dimensions();
+    let (out_width, out_height, output_len) =
+        thumbnail_dimensions(width, height, max_output_axis, max_output_rgba_bytes)?;
+    // This existing seam rejects source dimensions/native bytes/RGBA bytes
+    // BEFORE DynamicImage's full pixel allocation. Output limits do not grant
+    // a larger source allocation; input and output budgets are independent.
+    let (actual_width, actual_height, rgba) =
+        decode_owned_bounded_decoder(decoder, max_input_axis, max_input_rgba_bytes, limits)?;
+    if actual_width != width || actual_height != height
+        || rgba.capacity() as u64 > max_input_rgba_bytes
+    {
+        return None;
+    }
+    if (width, height) == (out_width, out_height) {
+        return ((rgba.capacity() as u64) <= max_output_rgba_bytes)
+            .then_some((width, height, rgba));
+    }
+    let output = thumbnail_rgba_boxes(
+        &rgba, width, height, out_width, out_height, output_len, max_output_rgba_bytes,
+    )?;
+    Some((out_width, out_height, output))
+}
+
+fn thumbnail_rgba_boxes(
+    source: &[u8], width: u32, height: u32,
+    out_width: u32, out_height: u32, output_len: usize, max_output_bytes: u64,
+) -> Option<Vec<u8>> {
+    // All dimensions are prevalidated. Keep an explicit boundary for this helper
+    // so a future caller cannot hand it inconsistent buffers or upscale work.
+    let source_len = bounded_rgba_len(width, height, width.max(height), source.len() as u64)?;
+    if source_len != source.len() || out_width == 0 || out_height == 0
+        || out_width > width || out_height > height
+        || bounded_rgba_len(out_width, out_height, out_width.max(out_height), max_output_bytes)? != output_len
+    {
+        return None;
+    }
+    let mut output = Vec::new();
+    output.try_reserve_exact(output_len).ok()?;
+    if output.capacity() as u64 > max_output_bytes {
+        return None;
+    }
+    output.resize(output_len, 0);
+    for oy in 0..out_height {
+        let y0 = u64::from(oy) * u64::from(height) / u64::from(out_height);
+        let y1 = u64::from(oy + 1) * u64::from(height) / u64::from(out_height);
+        for ox in 0..out_width {
+            let x0 = u64::from(ox) * u64::from(width) / u64::from(out_width);
+            let x1 = u64::from(ox + 1) * u64::from(width) / u64::from(out_width);
+            let count = (x1 - x0).checked_mul(y1 - y0)?;
+            if count == 0 {
+                return None;
+            }
+            // A generic caller may supply larger caps than Luma; prove each
+            // channel accumulator's maximum before adding any texels.
+            count.checked_mul(65_153)?; // Includes channel-sum rounding headroom.
+            let mut alpha = 0_u64;
+            let mut colors = [0_u64; 3];
+            for y in y0..y1 {
+                for x in x0..x1 {
+                    let at = usize::try_from((y * u64::from(width) + x) * 4).ok()?;
+                    let a = u64::from(source[at + 3]);
+                    alpha += a;
+                    for channel in 0..3 {
+                        colors[channel] += u64::from(source[at + channel]) * a;
+                    }
+                }
+            }
+            let at = usize::try_from((u64::from(oy) * u64::from(out_width) + u64::from(ox)) * 4).ok()?;
+            let averaged_alpha = ((alpha + count / 2) / count) as u8;
+            output[at + 3] = averaged_alpha;
+            if averaged_alpha != 0 && alpha != 0 {
+                for channel in 0..3 {
+                    output[at + channel] = ((colors[channel] + alpha / 2) / alpha) as u8;
+                }
+            }
+        }
+    }
+    Some(output)
+}
