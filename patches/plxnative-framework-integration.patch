+                assert_eq!(layout.value_at(scale, frame.x - 100.0), Some(-15));
+                assert_eq!(layout.value_at(scale, frame.x + frame.w + 100.0), Some(15));
+                assert_eq!(layout.value_at(scale, f32::NAN), None);
