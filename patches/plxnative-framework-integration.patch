+// ---- Staged signed range: a native setting editor, without service or commit ownership. ----
+/// Discrete range admitted once; geometry and staging share this exact scale.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RangeScale {
+    min: i64,
+    max: i64,
+    step: i64,
+}
+impl RangeScale {
+    pub fn new(min: i64, max: i64, step: i64) -> Option<Self> {
+        let span = max.checked_sub(min)?;
+        if step <= 0 || span <= 0 || span % step != 0 || span / step > 1_000_000 {
+            return None;
+        }
+        Some(Self { min, max, step })
+    }
+    pub fn min(self) -> i64 {
+        self.min
+    }
+    pub fn max(self) -> i64 {
+        self.max
+    }
+    pub fn step(self) -> i64 {
+        self.step
+    }
+    pub fn contains(self, value: i64) -> bool {
+        value >= self.min && value <= self.max && (value - self.min) % self.step == 0
+    }
+    fn fraction(self, value: i64) -> f32 {
+        ((value - self.min) as f64 / (self.max - self.min) as f64) as f32
+    }
+    fn at(self, fraction: f32) -> Option<i64> {
+        if !fraction.is_finite() {
+            return None;
+        }
+        let steps = (self.max - self.min) / self.step;
+        let index = (fraction.clamp(0.0, 1.0) as f64 * steps as f64).round() as i64;
+        Some(self.min + index * self.step)
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RangeStep {
+    Decrease,
+    Increase,
+}
+/// Local editing state only. Moving the thumb cannot commit or change the saved value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StagedRange {
+    scale: RangeScale,
+    saved: i64,
+    staged: i64,
+}
+impl StagedRange {
+    pub fn new(scale: RangeScale, saved: i64) -> Option<Self> {
+        scale.contains(saved).then_some(Self {
+            scale,
+            saved,
+            staged: saved,
+        })
+    }
+    pub fn scale(self) -> RangeScale {
+        self.scale
+    }
+    pub fn saved(self) -> i64 {
+        self.saved
+    }
+    pub fn staged(self) -> i64 {
+        self.staged
+    }
+    pub fn dirty(self) -> bool {
+        self.saved != self.staged
+    }
+    pub fn nudge(&mut self, direction: RangeStep) -> bool {
+        let value = match direction {
+            RangeStep::Decrease => self
+                .staged
+                .saturating_sub(self.scale.step)
+                .max(self.scale.min),
+            RangeStep::Increase => self
+                .staged
+                .saturating_add(self.scale.step)
+                .min(self.scale.max),
+        };
+        self.stage(value)
+    }
+    pub fn stage(&mut self, value: i64) -> bool {
+        if !self.scale.contains(value) || value == self.staged {
+            return false;
+        }
+        self.staged = value;
+        true
+    }
+    pub fn cancel(&mut self) {
+        self.staged = self.saved;
+    }
+    /// A transport owner must compare this pair against current capability/context before writing.
+    pub fn proposal(self) -> Option<(i64, i64)> {
+        self.dirty().then_some((self.saved, self.staged))
+    }
+    /// Only the owner of a verified readback may publish a successful commit.
+    pub fn confirm(&mut self, expected: i64, value: i64) -> bool {
+        if self.proposal() != Some((expected, value)) {
+            return false;
+        }
+        self.saved = value;
+        true
+    }
+}
+#[derive(Clone, Copy)]
+pub struct RangeLayout {
+    pub track: Rect,
+    pub thumb: Rect,
+    pub saved_marker: Rect,
+}
+impl RangeLayout {
+    pub fn new(frame: Rect, state: StagedRange) -> Option<Self> {
+        if ![frame.x, frame.y, frame.w, frame.h]
+            .iter()
+            .all(|v| v.is_finite())
+            || frame.w < 360.0
+            || frame.h < 168.0
+        {
+            return None;
+        }
+        let track = Rect::new(frame.x + 28.0, frame.y + 88.0, frame.w - 56.0, 8.0);
+        let thumb = Rect::new(
+            track.x + state.scale.fraction(state.staged) * track.w - 14.0,
+            track.cy() - 14.0,
+            28.0,
+            28.0,
+        );
+        let saved_marker = Rect::new(
+            track.x + state.scale.fraction(state.saved) * track.w - 2.0,
+            track.cy() - 19.0,
+            4.0,
+            38.0,
+        );
+        Some(Self {
+            track,
+            thumb,
+            saved_marker,
+        })
+    }
+    /// The same track that is painted maps a click to a discrete staged value.
+    pub fn value_at(self, scale: RangeScale, x: f32) -> Option<i64> {
+        scale.at((x - self.track.x) / self.track.w)
+    }
+}
