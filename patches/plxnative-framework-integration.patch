+    #[test]
+    fn thumbnail_bomb_header_and_truncated_data_refuse_without_big_fixture_image() {
+        let encoded = png(1, 1, &[1, 2, 3, 4]);
+        let mut bomb = encoded.clone();
+        bomb[16..20].copy_from_slice(&65_535_u32.to_be_bytes());
+        bomb[20..24].copy_from_slice(&65_535_u32.to_be_bytes());
+        let crc = crc32(&bomb[12..29]);
+        bomb[29..33].copy_from_slice(&crc.to_be_bytes());
+        assert!(bomb.len() < 1024);
+        assert!(img_decode_owned_thumbnail_bounded(&bomb, 2048, 8 * 1024 * 1024, 512, 1024 * 1024).is_none());
+        for end in [0, 1, 8, 16, 24, 32] {
+            assert!(img_decode_owned_thumbnail_bounded(&encoded[..end], 2048, 8 * 1024 * 1024, 512, 1024 * 1024).is_none());
+        }
