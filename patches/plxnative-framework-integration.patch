+impl RangeScale {
+    pub fn new(min: i64, max: i64, step: i64) -> Option<Self> {
+        let span = max.checked_sub(min)?;
+        if step <= 0 || span <= 0 || span % step != 0 || span / step > 1_000_000 {
+            return None;
+        }
+        Some(Self { min, max, step })
+    }
