+    #[test]
+    fn thumbnail_disjoint_opaque_source_boxes_cover_every_source_pixel() {
+        // Four input columns into two: complete boxes, no duplicated/omitted edge.
+        let encoded = png(4, 1, &[0, 0, 0, 255, 100, 0, 0, 255, 0, 100, 0, 255, 0, 0, 100, 255]);
+        assert_eq!(img_decode_owned_thumbnail_bounded(&encoded, 4, 16, 2, 8),
+            Some((2, 1, vec![50, 0, 0, 255, 0, 50, 50, 255])));
