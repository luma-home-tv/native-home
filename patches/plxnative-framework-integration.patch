+    fn paint_and_pointer_share_translated_discrete_track_geometry() {
+        let scale = RangeScale::new(-15, 15, 1).unwrap();
+        for value in -15..=15 {
+            let state = StagedRange::new(scale, value).unwrap();
+            for (x, y) in [(0.0, 0.0), (838.0, 480.0), (-40.0, 50.0)] {
+                let frame = Rect::new(x, y, 946.0, 184.0);
+                let layout = RangeLayout::new(frame, state).unwrap();
+                assert_eq!(layout.value_at(scale, layout.thumb.cx()), Some(value));
+                assert!(
+                    layout.thumb.x >= frame.x
