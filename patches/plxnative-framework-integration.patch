+            let called = Cell::new(false);
+            let decoder = ProbeDecoder { width: 1079, height: 1079, color: image::ColorType::Rgb8, read_called: &called };
+            let limits = owned_decode_limits(2048, 8 * 1024 * 1024).unwrap();
