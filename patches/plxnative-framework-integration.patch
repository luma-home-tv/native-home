+
+    // Independent source geometry: 1079x719 ->512x341, neither axis divides
+    // evenly. The generator uses per-texel predicates; the oracle integrates
+    // continuous source rectangles, NOT floor-selected integer source bins.
+    const QUALITY_SOURCE: (u32, u32) = (1079, 719);
+    const QUALITY_OUTPUT: (u32, u32) = (512, 341);
+    fn quality_source() -> Vec<u8> {
+        let mut rgba = Vec::new();
+        for y in 0..QUALITY_SOURCE.1 {
+            for x in 0..QUALITY_SOURCE.0 {
+                rgba.extend_from_slice(&[
+                    if x < 300 { 240 } else { 16 },
+                    if y < 216 { 224 } else { 24 },
+                    if x < 811 { 32 } else { 208 },
+                    if x < 500 { 127 } else { 255 },
+                ]);
+            }
+        }
+        rgba
+    }
+    fn quality_cell(x: u32, y: u32) -> [f64; 4] {
+        [f64::from(x) * 1079.0 / 512.0, f64::from(y) * 719.0 / 341.0,
+         f64::from(x + 1) * 1079.0 / 512.0, f64::from(y + 1) * 719.0 / 341.0]
+    }
+    fn quality_overlap(a: f64, z: f64, lo: f64, hi: f64) -> f64 {
+        (z.min(hi) - a.max(lo)).max(0.0)
+    }
+    fn quality_reference(cell: [f64; 4]) -> [f64; 4] {
+        // A piecewise-constant field integrated by physical rectangle overlap.
+        // Values here are independent literals, not generated via candidate
+        // pixel selection or even via quality_source(). Alpha is integrated in
+        // premultiplied form and then unpremultiplied to straight output RGB.
+        let columns = [(0.0, 300.0, 240.0, 32.0, 127.0),
+                       (300.0, 500.0, 16.0, 32.0, 127.0),
+                       (500.0, 811.0, 16.0, 32.0, 255.0),
+                       (811.0, 1079.0, 16.0, 208.0, 255.0)];
+        let rows = [(0.0, 216.0, 224.0), (216.0, 719.0, 24.0)];
+        let area = (cell[2] - cell[0]) * (cell[3] - cell[1]);
+        let mut alpha = 0.0;
+        let mut colors = [0.0; 3];
+        for (x0, x1, red, blue, a) in columns {
+            for (y0, y1, green) in rows {
+                let weight = quality_overlap(cell[0], cell[2], x0, x1)
+                    * quality_overlap(cell[1], cell[3], y0, y1);
+                alpha += weight * a;
+                colors[0] += weight * a * red;
+                colors[1] += weight * a * green;
+                colors[2] += weight * a * blue;
+            }
+        }
+        [colors[0] / alpha, colors[1] / alpha, colors[2] / alpha, alpha / area]
+    }
+    fn quality_exact_step(lo: f64, hi: f64, split: f64, a: u8, z: u8) -> Option<u8> {
+        if hi <= split { Some(a) } else if lo >= split { Some(z) } else { None }
+    }
+    #[derive(Debug)]
+    struct QualityObservation {
+        exact_interior_violations: usize,
+        source_range_violations: usize,
+        fractional_edge_components: usize,
+        max_channel_error: f64,
+        mean_absolute_channel_error: f64,
+        root_mean_square_channel_error: f64,
+        analytical_mean_absolute_bound: f64,
+    }
+    fn quality_observe(rgba: &[u8]) -> QualityObservation {
+        assert_eq!(rgba.len(), (QUALITY_OUTPUT.0 * QUALITY_OUTPUT.1 * 4) as usize);
+        let mut out = QualityObservation { exact_interior_violations: 0, source_range_violations: 0,
+            fractional_edge_components: 0, max_channel_error: 0.0,
+            mean_absolute_channel_error: 0.0, root_mean_square_channel_error: 0.0,
+            analytical_mean_absolute_bound: 0.0 };
+        let ranges = [(16, 240), (24, 224), (32, 208), (127, 255)];
+        let mut l1 = 0.0;
+        let mut l2 = 0.0;
+        let mut bound = 0.0;
+        for y in 0..QUALITY_OUTPUT.1 {
+            for x in 0..QUALITY_OUTPUT.0 {
+                let cell = quality_cell(x, y);
+                let expected = quality_reference(cell);
+                let exact = [quality_exact_step(cell[0], cell[2], 300.0, 240, 16),
+                             quality_exact_step(cell[1], cell[3], 216.0, 224, 24),
+                             quality_exact_step(cell[0], cell[2], 811.0, 32, 208),
+                             quality_exact_step(cell[0], cell[2], 500.0, 127, 255)];
+                let at = ((y * QUALITY_OUTPUT.0 + x) * 4) as usize;
+                for c in 0..4 {
+                    let observed = rgba[at + c];
+                    if observed < ranges[c].0 || observed > ranges[c].1 {
+                        out.source_range_violations += 1;
+                    }
+                    if let Some(value) = exact[c] {
+                        out.exact_interior_violations += usize::from(observed != value);
+                    } else {
+                        out.fractional_edge_components += 1;
+                        // Edge values have no arbitrary per-pixel fit threshold.
+                        // Their maximum possible error is the known source
+                        // channel contrast. All other components must be exact.
+                        bound += f64::from(ranges[c].1 - ranges[c].0);
+                    }
+                    let error = (f64::from(observed) - expected[c]).abs();
+                    out.max_channel_error = out.max_channel_error.max(error);
+                    l1 += error;
+                    l2 += error * error;
+                }
+            }
+        }
+        let count = rgba.len() as f64;
+        out.mean_absolute_channel_error = l1 / count;
+        out.root_mean_square_channel_error = (l2 / count).sqrt();
+        out.analytical_mean_absolute_bound = bound / count;
+        out
+    }
+    fn quality_control(rgba: &[u8], kind: &str) -> Vec<u8> {
+        let (w, h) = QUALITY_OUTPUT;
+        let mut result = vec![0; rgba.len()];
+        for y in 0..h {
+            for x in 0..w {
+                let (sx, sy) = match kind {
+                    "flip_x" => (w - x - 1, y), "flip_y" => (x, h - y - 1),
+                    "right_one" => (x.saturating_sub(1), y),
+                    "left_one" => ((x + 1).min(w - 1), y),
+                    "down_one" => (x, y.saturating_sub(1)),
+                    "up_one" => (x, (y + 1).min(h - 1)),
+                    "omit_lower_right" => (x, y),
+                    _ => panic!("closed quality-control set"),
+                };
+                let target = ((y * w + x) * 4) as usize;
+                let source = ((sy * w + sx) * 4) as usize;
+                if kind != "omit_lower_right" || x < w / 2 || y < h / 2 {
+                    result[target..target + 4].copy_from_slice(&rgba[source..source + 4]);
+                }
+            }
+        }
+        result
+    }
+    #[test]
+    fn thumbnail_nonconstant_noninteger_geometry_matches_interiors_and_rejects_wrong_placement() {
+        let source = quality_source();
+        let encoded = png(QUALITY_SOURCE.0, QUALITY_SOURCE.1, &source);
+        assert!(encoded.len() <= 1024 * 1024);
+        let (w, h, rgba) = img_decode_owned_thumbnail_bounded(
+            &encoded, 2048, 8 * 1024 * 1024, 512, 1024 * 1024,
+        ).unwrap();
+        assert_eq!((w, h), QUALITY_OUTPUT);
+        assert!(rgba.len() <= 1024 * 1024 && rgba.capacity() <= 1024 * 1024);
+        let observed = quality_observe(&rgba);
+        assert_eq!(observed.exact_interior_violations, 0, "asymmetric source geometry/colour/alpha interiors");
+        assert_eq!(observed.source_range_violations, 0, "no invented colour/alpha or erased region");
+        assert_eq!(observed.fractional_edge_components, 341 * 3 + 512);
+        // A design-derived whole-image bound, not a threshold fitted to the
+        // implementation: sum(edge-component-count * source-contrast) / all
+        // components. Floating oracle roundoff gets only an arithmetic epsilon.
+        assert!(observed.mean_absolute_channel_error <= observed.analytical_mean_absolute_bound + 1e-9);
+        eprintln!("Independent continuous-area observation: {observed:?}");
+        // Zero residual is allowed: a future better fractional-area filter is
+        // not required to reproduce this integer-box approximation's error.
+        for control in ["flip_x", "flip_y", "right_one", "left_one", "down_one", "up_one", "omit_lower_right"] {
+            let wrong = quality_observe(&quality_control(&rgba, control));
+            assert!(wrong.exact_interior_violations > 0 || wrong.source_range_violations > 0,
+                "wrong placement/omitted-region control must violate the same exact oracle: {control}: {wrong:?}");
+        }
+    }
+
+}
